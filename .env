# MySQL Database Configuration (switch to this when MySQL is available)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/userdb

# SQLite fallback for testing
DATABASE_URL=sqlite:///./userdb.db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQL_DEBUG=false
